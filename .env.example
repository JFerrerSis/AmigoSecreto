# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase - credenciales públicas (seguras para el navegador)
# Las usa lib/supabase/client.ts y el cliente anon del servidor.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Alias de servidor para las mismas credenciales públicas.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Opcional: secret/service role key. SOLO se usa en el servidor para
# operaciones que necesitan saltar RLS con @supabase/supabase-js.
# Nunca la pongas con prefijo NEXT_PUBLIC_ ni la subas al repositorio.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Postgres de Supabase
# ------------------------------------------------------------
# Runtime de la app (Vercel/serverless): Transaction Pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migraciones y scripts: conexión directa o Session Pooler.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Alternativa soportada por la app si tu hosting inyecta POSTGRES_URL.
# POSTGRES_URL=

# SSL: déjalo en true para Supabase. Usa false solo con Postgres local.
DATABASE_SSL=true

# El pooler de Supabase usa una cadena autofirmada: TLS cifra el tráfico
# pero no valida la cadena. Si configuras DATABASE_SSL_CA, activa true.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Cookies: activar en producción con HTTPS.
COOKIE_SECURE=false

# Firma de sesión: obligatoria en producción, mínimo 32 caracteres aleatorios.
SESSION_SECRET=

# Opcional: permite ver detalles de /api/health con el header x-health-token.
HEALTH_CHECK_TOKEN=

# ------------------------------------------------------------
# Email opcional con Resend
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Amigo Secreto <hola@tudominio.com>"
